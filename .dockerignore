# Keep the build context small: only src/, artifacts/ and pyproject.toml are copied.
.git
.github
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
tests
benchmarks
docs
reports
datasets
k8s
# Intermediate and regenerated artifacts are not needed to serve requests.
artifacts/interim
artifacts/evaluation
artifacts/logs
artifacts/retry_buffer.jsonl
